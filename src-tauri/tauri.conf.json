{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LittleFishTank",
  "version": "0.1.0",
  "identifier": "com.qiu.tank",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "小鱼缸壁纸",
        "width": 760,
        "height": 560,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
